# Kopieren nach .env und mit den echten Werten des jeweiligen RootResolver-
# Netzwerks fuellen. .env selbst niemals committen.

PORT=3000

# Fabric-Identitaet / Channel / Chaincode - fachlich fix, vom RootResolver-
# Netzwerk vorgegeben (siehe RWP-25 / Operating Handbook).
CRYPTO_DIR=/crypto/peerOrganizations/org.recordweb.dev
MSP_ID=TWSOrgMSP
ORG_DOMAIN=org.recordweb.dev
ADMIN_IDENTITY=tws-org-admin
ADMIN_CERT_FILENAME=cert.pem
CHANNEL_NAME=rw-gnr-test
CHAINCODE_NAME=rw-cc-gnr

# Einziger Wert, der pro Nutzung/Deployment variieren darf: Adresse des
# Fabric-Peers, gegen den ResolveNamespace ausgefuehrt wird.
PEER_ENDPOINT=peer0.tws.rwrrn.recordweb.dev:7051
PEER_HOST_ALIAS=peer0.tws.rwrrn.recordweb.dev

# Erlaubt Nutzern der Web-UI, den Peer ueber das Dreieck-Menue zu wechseln
# (z.B. um gegen einen anderen Organisations-Peer im selben Netzwerk zu testen).
# Auf false setzen, um die Peer-Adresse serverseitig fest zu verdrahten.
ALLOW_CLIENT_PEER_OVERRIDE=true

FETCH_TIMEOUT_MS=4000
